# Skopiuj ten plik do `.env` i wypelnij swoimi sekretami z Cloudinary
# (Cloudinary Console -> Settings -> API Keys)
#
# UWAGA: plik `.env` jest w .gitignore - nie zostanie zacommitowany.

CLOUDINARY_CLOUD_NAME=twoj-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=twoj-api-secret
